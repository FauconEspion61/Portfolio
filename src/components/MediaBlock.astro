---
import fs from "node:fs";
import path from "node:path";
import { mediaSrc, type ProjectMedia } from "../data/projects";
import { t, type Lang } from "../i18n";

interface Props {
  item: ProjectMedia;
  lang: Lang;
}

const { item, lang } = Astro.props;
const src = mediaSrc(item, lang);
const alt = t(item.alt, lang);
const caption = item.caption ? t(item.caption, lang) : null;

/**
 * Les schémas SVG sont injectés directement dans la page (plutôt que via <img>)
 * pour que leurs couleurs suivent le thème choisi sur le site, et pas seulement
 * la préférence clair/sombre du système d'exploitation.
 */
let inlineSvg: string | null = null;
if (item.type === "diagram" && src.endsWith(".svg")) {
  try {
    inlineSvg = fs.readFileSync(path.join(process.cwd(), "public", src), "utf-8");
  } catch {
    inlineSvg = null;
  }
}
---

<figure class:list={["media-block", { diagram: item.type === "diagram" }]}>
  {
    item.type === "video" ? (
      <video autoplay muted loop playsinline aria-label={alt}>
        <source src={src} />
      </video>
    ) : inlineSvg ? (
      <div class="svg-holder" set:html={inlineSvg} />
    ) : (
      <img src={src} alt={alt} loading="lazy" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-block {
    margin: 30px 0;
  }

  .media-block img,
  .media-block video,
  .svg-holder {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  /* La vidéo prend sa taille naturelle dans les limites du bloc, puis se centre :
     une vidéo portrait s'affiche donc sans bandes noires, et une vidéo paysage
     occupe toujours toute la largeur. */
  .media-block video {
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .media-block:not(.diagram) img {
    max-height: 520px;
    object-fit: cover;
    background: #000;
  }

  /* `contain` et non `cover` : les vidéos filmées au téléphone sont en portrait,
     un recadrage en couperait l'essentiel. */
  .media-block video {
    max-height: 560px;
    object-fit: contain;
    background: #000;
  }

  .media-block.diagram img {
    background: var(--bg-elev);
    padding: 18px;
  }

  .svg-holder {
    background: var(--bg-elev);
    padding: 18px;
  }

  .svg-holder :global(svg) {
    display: block;
    width: 100%;
    height: auto;

    /* On surcharge la palette interne des schémas avec les tokens du site :
       plus spécifique que leur règle `svg { ... }`, donc le thème du site gagne. */
    --bg: var(--bg-elev);
    --surface: var(--bg-elev);
    --ink: var(--text);
    --muted: var(--text-muted);
    --line: var(--border-strong);
    --cpu: var(--diagram-cpu);
    --gpu: var(--diagram-gpu);
    --cpuSoft: var(--diagram-cpu-soft);
    --gpuSoft: var(--diagram-gpu-soft);
  }

  .media-block figcaption {
    margin-top: 10px;
    padding-left: 14px;
    border-left: 2px solid var(--border-strong);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
