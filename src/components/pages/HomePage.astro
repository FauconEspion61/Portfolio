---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../ProjectCard.astro";
import { site } from "../../data/site";
import { projects } from "../../data/projects";
import { ROUTES, t, ui, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const featured = projects.slice(0, 3);
const stats = [
  { value: String(projects.length), label: t(ui.statProjects, lang) },
  ...site.stats.map((s) => ({ value: s.value, label: t(s.label, lang) })),
];

const firstName = site.name.split(" ")[0];
const lastName = site.name.split(" ").slice(1).join(" ");
---

<Layout lang={lang} title={`${site.name} — Portfolio`} description={t(site.tagline, lang)}>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="aurora" aria-hidden="true">
      <i class="a1"></i>
      <i class="a2"></i>
    </div>

    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>{t(ui.eyebrowPortfolio, lang)}</p>

      <h1 class="hero-title" data-reveal style="--reveal-delay: 60ms">
        {firstName}<br />
        <span class="gradient-text">{lastName}</span>
      </h1>

      <p class="hero-role" data-reveal style="--reveal-delay: 120ms">{t(site.role, lang)}</p>
      <p class="lead hero-lead" data-reveal style="--reveal-delay: 180ms">{t(site.tagline, lang)}</p>

      <div class="hero-actions" data-reveal style="--reveal-delay: 240ms">
        <a class="btn btn-primary" href={t(ROUTES.projects, lang)}>
          {t(ui.heroCtaProjects, lang)}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a class="btn" href={t(ROUTES.about, lang)}>{t(ui.heroCtaAbout, lang)}</a>
      </div>

      <div class="hero-meta" data-reveal style="--reveal-delay: 300ms">
        {site.availability && <span class="pill pill-accent pill-dot">{t(site.availability, lang)}</span>}
        <span class="pill">{t(site.location, lang)}</span>
        {
          site.links.github && (
            <a class="hero-link" href={site.links.github} target="_blank" rel="noreferrer">
              GitHub
            </a>
          )
        }
        {
          site.links.linkedin && (
            <a class="hero-link" href={site.links.linkedin} target="_blank" rel="noreferrer">
              LinkedIn
            </a>
          )
        }
        <a class="hero-link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>

  <!-- ============================ CHIFFRES ============================ -->
  <section class="section-tight stats-section">
    <div class="container">
      <div class="stats" data-reveal>
        {
          stats.map((stat) => (
            <div class="stat">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ PROJETS ============================ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{t(ui.eyebrowSelection, lang)}</p>
          <h2>{t(ui.featuredProjects, lang)}</h2>
        </div>
        <a class="link-arrow" href={t(ROUTES.projects, lang)}>
          {t(ui.allProjects, lang)}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="grid">
        {
          featured.map((project, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 90}ms`} class:list={{ span: i === 0 }}>
              <ProjectCard project={project} lang={lang} featured={i === 0} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ COMPÉTENCES ============================ -->
  <section class="section skills-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{t(ui.eyebrowToolbox, lang)}</p>
          <h2>{t(ui.technicalSkills, lang)}</h2>
        </div>
      </div>

      <div class="skills">
        {
          site.skills.map((group, i) => (
            <div class="skill-card surface" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <h3 class="skill-title">{t(group.category, lang)}</h3>
              <ul class="skill-list">
                {t(group.items, lang).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="section-tight">
    <div class="container">
      <div class="cta" data-reveal>
        <div class="aurora" aria-hidden="true"><i class="a1"></i></div>
        <div class="cta-content">
          <h2>{t(ui.ctaTitle, lang)}</h2>
          <p class="lead">{t(ui.ctaLead, lang)}</p>
          <div class="cta-actions">
            <a class="btn btn-primary" href={`mailto:${site.email}`}>{t(ui.contactMe, lang)}</a>
            <a class="btn" href={t(ROUTES.about, lang)}>{t(ui.seeBackground, lang)}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    padding: clamp(70px, 12vw, 130px) 0 clamp(56px, 8vw, 96px);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.8rem, 9vw, 6.2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-bottom: 22px;
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: 18px;
    line-height: 1.7;
  }

  .hero-lead {
    font-size: clamp(1rem, 2vw, 1.15rem);
    margin-bottom: 34px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 34px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px 18px;
    flex-wrap: wrap;
    padding-top: 26px;
    border-top: 1px solid var(--border);
  }

  .hero-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .hero-link:hover {
    color: var(--accent);
  }

  /* ---------- chiffres ---------- */

  .stats-section {
    padding-top: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 24px;
    background: var(--bg-elev);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* ---------- grilles ---------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 22px;
  }

  .grid > div {
    display: flex;
  }

  .grid > div > :global(.card) {
    width: 100%;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid > .span {
      grid-column: 1 / -1;
    }
  }

  .skills-section {
    background: var(--bg-sunken);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(232px, 1fr));
    gap: 18px;
  }

  .skill-card {
    padding: 22px 24px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .skill-title {
    font-size: 0.98rem;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .skill-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .skill-list li {
    position: relative;
    padding-left: 16px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .skill-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  /* ---------- CTA ---------- */

  .cta {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 6px);
    background: var(--bg-elev);
    padding: clamp(36px, 6vw, 64px);
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .cta h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
</style>
